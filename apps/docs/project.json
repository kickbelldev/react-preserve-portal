{
  "name": "docs",
  "projectType": "application",
  "sourceRoot": "apps/docs",
  "targets": {
    "check-output": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "python3 scripts/check-docs-output.py"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "inputs": [
        "default",
        "^default",
        { "env": "DOCS_ANALYTICS_ENABLED" },
        { "env": "DOCS_ANALYTICS_TOKEN" }
      ],
      "outputs": ["{workspaceRoot}/dist/apps/docs"],
      "options": {
        "command": "vitepress build .",
        "cwd": "apps/docs"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["^build"],
      "options": {
        "command": "vitepress dev . --host 127.0.0.1 --port 4173",
        "cwd": "apps/docs"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": [],
      "options": {
        "command": "vitepress preview .",
        "cwd": "apps/docs"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "commands": [
          "tsc --noEmit -p apps/docs/tsconfig.json",
          "node scripts/check-doc-examples.mjs"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --experimental-strip-types --test apps/docs/.vitepress/analytics.test.mjs"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/docs/.vitepress/theme/playground.tsx",
          "apps/docs/.vitepress/analytics.ts"
        ],
        "fix": false
      }
    }
  }
}
